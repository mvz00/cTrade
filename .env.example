# cTrade Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Application
CTRADE_DEBUG=false
CTRADE_LOG_LEVEL=INFO
CTRADE_API_HOST=127.0.0.1
CTRADE_API_PORT=8000

# Encryption key for API credential storage (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
CTRADE_ENCRYPTION_KEY=

# Database
CTRADE_DB__URL=postgresql+asyncpg://ctrade:ctrade@localhost:5432/ctrade
CTRADE_DB__POOL_SIZE=10

# Redis
CTRADE_REDIS__URL=redis://localhost:6379/0

# Trading
CTRADE_TRADING__MODE=paper
CTRADE_TRADING__DEFAULT_QUOTE_CURRENCY=USDT
CTRADE_TRADING__MAX_OPEN_POSITIONS=5

# Risk Management
CTRADE_RISK__MAX_POSITION_PCT=0.10
CTRADE_RISK__MAX_DAILY_LOSS_PCT=0.05
CTRADE_RISK__MAX_DRAWDOWN_PCT=0.15
CTRADE_RISK__DEFAULT_STOP_LOSS_PCT=0.03
CTRADE_RISK__DEFAULT_TAKE_PROFIT_PCT=0.06

# Strategy
CTRADE_STRATEGY__TECHNICAL_WEIGHT=0.50
CTRADE_STRATEGY__SENTIMENT_WEIGHT=0.30
CTRADE_STRATEGY__ONCHAIN_WEIGHT=0.20
CTRADE_STRATEGY__ENTRY_CONFIDENCE_THRESHOLD=0.70
CTRADE_STRATEGY__EXIT_CONFIDENCE_THRESHOLD=0.30

# Feed API Keys
CTRADE_FEEDS__COINMARKETCAP_API_KEY=
CTRADE_FEEDS__TWITTER_BEARER_TOKEN=
CTRADE_FEEDS__REDDIT_CLIENT_ID=
CTRADE_FEEDS__REDDIT_CLIENT_SECRET=
CTRADE_FEEDS__GLASSNODE_API_KEY=

# Dashboard Auth
CTRADE_AUTH__SECRET_KEY=
CTRADE_AUTH__USERNAME=admin
CTRADE_AUTH__PASSWORD_HASH=
